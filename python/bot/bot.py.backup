import os
import json
from dotenv import load_dotenv
from telegram import (
    Update, ReplyKeyboardMarkup, KeyboardButton
)
from telegram.ext import (
    ApplicationBuilder, CommandHandler, MessageHandler,
    ContextTypes, filters, ConversationHandler
)
from docx import Document
from datetime import datetime

# ===== ENV =====
load_dotenv()
TOKEN = os.getenv("BOT_TOKEN")
ADMIN_ID = int(os.getenv("ADMIN_ID"))

USERS_FILE = "users.json"
OUTPUT_DIR = "output"

if not os.path.exists(USERS_FILE):
    with open(USERS_FILE, "w") as f:
        json.dump({}, f)

# ===== STATES =====
LOGIN, PASSWORD, MENU, ADMIN_PANEL = range(4)

# ===== HELPERS =====
def load_users():
    with open(USERS_FILE, "r") as f:
        return json.load(f)

def save_users(data):
    with open(USERS_FILE, "w") as f:
        json.dump(data, f, indent=2)

def replace_docx(template, replacements, user_id):
    doc = Document(template)
    for p in doc.paragraphs:
        for k, v in replacements.items():
            if k in p.text:
                p.text = p.text.replace(k, v)

    filename = f"{OUTPUT_DIR}/{user_id}_{int(datetime.now().timestamp())}.docx"
    doc.save(filename)
    return filename

# ===== START =====
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Login kiriting:")
    return LOGIN

# ===== LOGIN =====
async def login(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data["login"] = update.message.text
    await update.message.reply_text("Parol kiriting:")
    return PASSWORD

# ===== PASSWORD =====
async def password(update: Update, context: ContextTypes.DEFAULT_TYPE):
    login = context.user_data["login"]
    password = update.message.text
    users = load_users()

    for uid, data in users.items():
        if data["login"] == login and data["password"] == password:
            context.user_data["auth"] = True
            return await show_menu(update)

    await update.message.reply_text("❌ Login yoki parol xato. Kirish taqiqlanadi.")
    return ConversationHandler.END

# ===== MENU =====
async def show_menu(update: Update):
    keyboard = [
        ["1. Kelmagan kuniz", "2. Javob so‘rash"],
        ["4. Kechga qolish", "5. Tushuntirish xati"]
    ]

    if update.effective_user.id == ADMIN_ID:
        keyboard.append(["🛠 Admin panel"])

    await update.message.reply_text(
        "Bo‘limni tanlang:",
        reply_markup=ReplyKeyboardMarkup(keyboard, resize_keyboard=True)
    )
    return MENU

# ===== ADMIN PANEL =====
async def admin_panel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return

    kb = [["➕ User qo‘shish", "❌ User o‘chirish"]]
    await update.message.reply_text("Admin panel:", reply_markup=ReplyKeyboardMarkup(kb, resize_keyboard=True))
    return ADMIN_PANEL

# ===== MAIN =====
def main():
    app = ApplicationBuilder().token(TOKEN).build()

    conv = ConversationHandler(
        entry_points=[CommandHandler("start", start)],
        states={
            LOGIN: [MessageHandler(filters.TEXT & ~filters.COMMAND, login)],
            PASSWORD: [MessageHandler(filters.TEXT & ~filters.COMMAND, password)],
            MENU: [
                MessageHandler(filters.Regex("🛠 Admin panel"), admin_panel)
            ],
            ADMIN_PANEL: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, admin_panel)
            ]
        },
        fallbacks=[]
    )

    app.add_handler(conv)
    app.run_polling()

if __name__ == "__main__":
    main()
